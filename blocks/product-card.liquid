{%- liquid
  assign product = block.settings.product
  assign first_variant = product.variants.first
  assign product_image = first_variant.featured_image | default: product.featured_image
  assign product_title = block.settings.custom_title | default: product.title
  assign product_description = block.settings.custom_description | default: product.description
  assign product_labels = product.metafields.custom.product_labels.value
  assign color_option = null
  assign color_option_position = null
  assign selected_color = null

  if product != blank
    for option in product.options_with_values
      if option.name == 'Color'
        assign color_option = option
        assign color_option_position = forloop.index
      endif
    endfor

    case color_option_position
      when 1
        assign selected_color = first_variant.option1
      when 2
        assign selected_color = first_variant.option2
      when 3
        assign selected_color = first_variant.option3
    endcase
  endif
-%}

<article
  class="product-card-block"
  data-product-card-block
  data-selected-variant-id="{{ first_variant.id }}"
  data-redirect-to-cart="{{ block.settings.redirect_to_cart }}"
  data-cart-url="{{ routes.cart_url }}"
  data-logic-src="{{ 'product-card-logic.js' | asset_url }}"
  {{ block.shopify_attributes }}
>
  {%- if product != blank and first_variant != blank -%}
    <div class="product-card-block__media">
      {%- if product_image != blank -%}
        {{
          product_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '180, 360, 540, 720, 900',
            sizes: '(min-width: 990px) 360px, (min-width: 750px) 45vw, 100vw',
            class: 'product-card-block__image'
        }}
      {%- else -%}
        {{ 'product-apparel-2' | placeholder_svg_tag: 'product-card-block__image product-card-block__placeholder' }}
      {%- endif -%}
    </div>

    <div class="product-card-block__content">
      {%- if product_labels != blank -%}
        <ul class="product-card-block__labels list-unstyled" role="list">
          {%- for label in product_labels -%}
            <li
              class="product-card-block__label"
              style="--product-card-label-color: {{ block.settings.label_text_color }}; --product-card-label-background: {{ block.settings.label_background_color }};"
            >
              {{ label | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <h3 class="product-card-block__title">
        {{ product_title | escape }}
      </h3>

      {%- if product_description != blank -%}
        <div class="product-card-block__description rte">
          {{ product_description }}
        </div>
      {%- endif -%}

      <div class="product-card-block__prices">
        <span class="product-card-block__price" data-product-card-price>
          {{ first_variant.price | money }}
        </span>

        <s
          class="product-card-block__compare-price{% unless first_variant.compare_at_price > first_variant.price %} product-card-block__compare-price--hidden{% endunless %}"
          data-product-card-compare-price
        >
          {%- if first_variant.compare_at_price > first_variant.price -%}
            {{ first_variant.compare_at_price | money }}
          {%- endif -%}
        </s>
      </div>

      {%- if color_option != blank -%}
        <div class="product-card-block__swatches">
          {%- for value in color_option.values -%}
            {%- liquid
              assign swatch_variant = null

              for variant in product.variants
                assign variant_color = null

                case color_option_position
                  when 1
                    assign variant_color = variant.option1
                  when 2
                    assign variant_color = variant.option2
                  when 3
                    assign variant_color = variant.option3
                endcase

                if variant_color == value and swatch_variant == blank
                  assign swatch_variant = variant
                endif
              endfor
            -%}
            <button
              type="button"
              class="product-card-block__swatch{% if value == selected_color %} product-card-block__swatch--selected{% endif %}"
              style="--product-card-swatch-color: {{ value | handle }};"
              aria-label="{{ value | escape }}"
              data-product-card-swatch
              data-variant-id="{{ swatch_variant.id }}"
              data-color-value="{{ value | escape }}"
              {% if value == selected_color %}
                aria-current="true"
              {% endif %}
            >
              <span class="visually-hidden">{{ value }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <button
        type="button"
        class="product-card-block__button button{% unless first_variant.available %} product-card-block__button--sold-out{% endunless %}"
        data-product-card-button
        data-available-text="{{ block.settings.cta_available_text | escape }}"
        data-sold-out-text="{{ block.settings.cta_out_of_stock_text | escape }}"
        data-adding-text="{{ 'blocks.product_card.cart.adding' | t | escape }}"
        {% unless first_variant.available %}
          disabled
        {% endunless %}
      >
        {%- if first_variant.available -%}
          {{ block.settings.cta_available_text | escape }}
        {%- else -%}
          {{ block.settings.cta_out_of_stock_text | escape }}
        {%- endif -%}
      </button>

      <p
        class="product-card-block__status"
        role="status"
        aria-live="polite"
        data-product-card-status
        data-success-text="{{ 'general.cart.item_added' | t | escape }}"
        data-error-text="{{ 'blocks.product_card.cart.error' | t | escape }}"
      ></p>

      <script type="application/json" data-product-card-variants>
        [
          {%- for variant in product.variants -%}
            {%- liquid
              assign variant_image = variant.featured_image | default: product.featured_image
              assign variant_color = null
              assign has_compare_at_price = false

              case color_option_position
                when 1
                  assign variant_color = variant.option1
                when 2
                  assign variant_color = variant.option2
                when 3
                  assign variant_color = variant.option3
              endcase

              if variant.compare_at_price > variant.price
                assign has_compare_at_price = true
              endif

              capture variant_image_srcset
                if variant_image != blank
                  echo variant_image | image_url: width: 180
                  echo ' 180w, '
                  echo variant_image | image_url: width: 360
                  echo ' 360w, '
                  echo variant_image | image_url: width: 540
                  echo ' 540w, '
                  echo variant_image | image_url: width: 720
                  echo ' 720w, '
                  echo variant_image | image_url: width: 900
                  echo ' 900w'
                endif
              endcapture
            -%}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price | money | json }},
              "compareAtPrice": {{ variant.compare_at_price | money | json }},
              "hasCompareAtPrice": {{ has_compare_at_price | json }},
              "color": {{ variant_color | json }},
              "image": {
                "src": {%- if variant_image != blank -%}{{ variant_image | image_url: width: 900 | json }}{%- else -%}null{%- endif -%},
                "srcset": {{ variant_image_srcset | strip | json }},
                "alt": {%- if variant_image != blank and variant_image.alt != blank -%}{{ variant_image.alt | json }}{%- else -%}{{ product.title | json }}{%- endif -%}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    </div>
  {%- else -%}
    <div class="product-card-block__empty">
      {{ 'blocks.product_card.preview.no_product' | t }}
    </div>
  {%- endif -%}
</article>

{% stylesheet %}
  .product-card-block {
    display: grid;
    gap: 2rem;
    padding: 2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.12);
    border-radius: var(--media-radius);
    background: rgb(var(--color-background));
  }

  .product-card-block__media {
    overflow: hidden;
    border-radius: var(--media-radius);
    background: rgba(var(--color-foreground), 0.04);
  }

  .product-card-block__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .product-card-block__placeholder {
    inline-size: 100%;
    min-block-size: 24rem;
  }

  .product-card-block__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .product-card-block__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
  }

  .product-card-block__label {
    max-inline-size: 100%;
    padding: 0.4rem 0.8rem;
    border-radius: 999rem;
    color: var(--product-card-label-color);
    background: var(--product-card-label-background);
    font-size: 1.2rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .product-card-block__title {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
  }

  .product-card-block__description {
    color: rgba(var(--color-foreground), 0.75);
  }

  .product-card-block__description > * {
    margin-block-start: 0;
  }

  .product-card-block__description > :last-child {
    margin-block-end: 0;
  }

  .product-card-block__prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem;
  }

  .product-card-block__price {
    font-weight: 700;
  }

  .product-card-block__compare-price {
    color: rgba(var(--color-foreground), 0.6);
  }

  .product-card-block__compare-price--hidden {
    display: none;
  }

  .product-card-block__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .product-card-block__swatch {
    inline-size: 2.4rem;
    block-size: 2.4rem;
    padding: 0;
    border: 0.1rem solid rgba(var(--color-foreground), 0.25);
    border-radius: 50%;
    background-color: var(--product-card-swatch-color);
    cursor: pointer;
  }

  .product-card-block__swatch--selected {
    outline: 0.2rem solid rgb(var(--color-foreground));
    outline-offset: 0.2rem;
  }

  .product-card-block__button {
    margin-block-start: 0.4rem;
  }

  .product-card-block__button--sold-out {
    opacity: 0.6;
  }

  .product-card-block__status {
    min-block-size: 1.6rem;
    margin: 0;
    color: rgba(var(--color-foreground), 0.75);
    font-size: 1.2rem;
  }

  .product-card-block__empty {
    color: rgba(var(--color-foreground), 0.7);
  }
{% endstylesheet %}

{% javascript %}
  (() => {
  class ProductCardBlock {
    constructor(card) {
      this.card = card;
      this.image = card.querySelector('.product-card-block__image');
      this.price = card.querySelector('[data-product-card-price]');
      this.comparePrice = card.querySelector('[data-product-card-compare-price]');
      this.button = card.querySelector('[data-product-card-button]');
      this.status = card.querySelector('[data-product-card-status]');
      this.swatches = card.querySelectorAll('[data-product-card-swatch]');
      this.variants = this.getVariants();
      this.isAdding = false;

      this.bindEvents();
    }

    getVariants() {
      const dataScript = this.card.querySelector('[data-product-card-variants]');

      if (!dataScript) {
        return [];
      }

      try {
        return JSON.parse(dataScript.textContent);
      } catch (error) {
        return [];
      }
    }

    bindEvents() {
      this.swatches.forEach((swatch) => {
        swatch.addEventListener('click', () => {
          const variant = this.findVariant(swatch);

          if (variant) {
            this.updateVariant(variant, swatch);
          }
        });
      });

      if (this.button) {
        this.button.addEventListener('click', () => this.addSelectedVariantToCart());
      }
    }

    findVariant(swatch) {
      const variantId = Number(swatch.dataset.variantId);
      const colorValue = swatch.dataset.colorValue;

      return window.ProductCardLogic.findVariant(this.variants, { variantId, colorValue });
    }

    updateVariant(variant, selectedSwatch) {
      this.card.dataset.selectedVariantId = variant.id;
      this.clearStatus();
      this.updateImage(variant);
      this.updatePrices(variant);
      this.updateButton(variant);
      this.updateSwatches(selectedSwatch);
    }

    updateImage(variant) {
      if (!this.image || !variant.image || !variant.image.src) {
        return;
      }

      this.image.src = variant.image.src;

      if (variant.image.srcset) {
        this.image.srcset = variant.image.srcset;
      }

      this.image.alt = variant.image.alt || '';
    }

    updatePrices(variant) {
      if (this.price) {
        this.price.textContent = variant.price;
      }

      if (!this.comparePrice) {
        return;
      }

      if (variant.hasCompareAtPrice) {
        this.comparePrice.textContent = variant.compareAtPrice;
        this.comparePrice.classList.remove('product-card-block__compare-price--hidden');
      } else {
        this.comparePrice.textContent = '';
        this.comparePrice.classList.add('product-card-block__compare-price--hidden');
      }
    }

    updateButton(variant) {
      if (!this.button) {
        return;
      }

      if (this.isAdding) {
        return;
      }

      const { disabled, text } = window.ProductCardLogic.deriveCtaState(variant, {
        availableText: this.button.dataset.availableText,
        soldOutText: this.button.dataset.soldOutText,
      });

      this.button.disabled = disabled;
      this.button.textContent = text;
      this.button.classList.toggle('product-card-block__button--sold-out', disabled);
    }

    updateSwatches(selectedSwatch) {
      this.swatches.forEach((swatch) => {
        const isSelected = swatch === selectedSwatch;

        swatch.classList.toggle('product-card-block__swatch--selected', isSelected);

        if (isSelected) {
          swatch.setAttribute('aria-current', 'true');
        } else {
          swatch.removeAttribute('aria-current');
        }
      });
    }

    getSelectedVariant() {
      const selectedVariantId = Number(this.card.dataset.selectedVariantId);

      return window.ProductCardLogic.getSelectedVariant(this.variants, selectedVariantId);
    }

    async addSelectedVariantToCart() {
      const variant = this.getSelectedVariant();

      if (!window.ProductCardLogic.canAddToCart(variant, { isAdding: this.isAdding })) {
        return;
      }

      this.setAddingState(true);
      this.clearStatus();

      try {
        const response = await fetch(this.getCartAddUrl(), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            items: [
              {
                id: variant.id,
                quantity: 1,
              },
            ],
          }),
        });

        const responseJson = await response.json();

        if (!response.ok || responseJson.status) {
          throw new Error(responseJson.description || responseJson.message || 'Cart add failed');
        }

        if (this.card.dataset.redirectToCart === 'true') {
          window.location.href = this.card.dataset.cartUrl || '/cart';
          return;
        }

        this.showStatus(this.status?.dataset.successText || '');
      } catch (error) {
        this.showStatus(this.status?.dataset.errorText || '');
      } finally {
        this.setAddingState(false);
        this.updateButton(this.getSelectedVariant() || variant);
      }
    }

    getCartAddUrl() {
      const root = window.Shopify?.routes?.root;

      if (root) {
        return `${root}cart/add.js`;
      }

      return '/cart/add.js';
    }

    setAddingState(isAdding) {
      this.isAdding = isAdding;

      if (!this.button) {
        return;
      }

      this.button.disabled = isAdding;
      this.button.toggleAttribute('aria-busy', isAdding);

      if (isAdding) {
        this.button.textContent = this.button.dataset.addingText;
      }
    }

    showStatus(message) {
      if (!this.status) {
        return;
      }

      this.status.textContent = message;
    }

    clearStatus() {
      this.showStatus('');
    }
  }

  let logicLoadPromise = null;

  const loadProductCardLogic = (src) => {
    if (window.ProductCardLogic) {
      return Promise.resolve();
    }

    if (logicLoadPromise) {
      return logicLoadPromise;
    }

    logicLoadPromise = new Promise((resolve, reject) => {
      const existingScript = document.querySelector('[data-product-card-logic-script]');

      if (existingScript) {
        existingScript.addEventListener('load', resolve, { once: true });
        existingScript.addEventListener('error', reject, { once: true });
        return;
      }

      const script = document.createElement('script');
      script.src = src;
      script.dataset.productCardLogicScript = 'true';
      script.addEventListener('load', resolve, { once: true });
      script.addEventListener('error', reject, { once: true });
      document.head.appendChild(script);
    });

    return logicLoadPromise;
  };

  const initProductCardBlocks = () => {
    document.querySelectorAll('[data-product-card-block]').forEach((card) => {
      if (card.dataset.productCardInitialized === 'true') {
        return;
      }

      card.dataset.productCardInitialized = 'true';

      loadProductCardLogic(card.dataset.logicSrc)
        .then(() => new ProductCardBlock(card))
        .catch(() => {
          card.dataset.productCardInitialized = 'false';
        });
    });
  };

  initProductCardBlocks();

  document.addEventListener('shopify:section:load', initProductCardBlocks);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:blocks.product_card.name",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:blocks.product_card.settings.product.label"
    },
    {
      "type": "checkbox",
      "id": "redirect_to_cart",
      "label": "t:blocks.product_card.settings.redirect_to_cart.label",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "t:blocks.product_card.settings.custom_title.label"
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "t:blocks.product_card.settings.custom_description.label"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "t:blocks.product_card.settings.label_text_color.label",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "label_background_color",
      "label": "t:blocks.product_card.settings.label_background_color.label",
      "default": "#f3f3f3"
    },
    {
      "type": "text",
      "id": "cta_available_text",
      "label": "t:blocks.product_card.settings.cta_available_text.label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "cta_out_of_stock_text",
      "label": "t:blocks.product_card.settings.cta_out_of_stock_text.label",
      "default": "Sold out"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_card.name"
    }
  ]
}
{% endschema %}
